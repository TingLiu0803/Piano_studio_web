NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Canonical Maps/Business Profile URL (recommended over short share links for stable sameAs + footer links)
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=https://maps.google.com/?cid=your-place-id
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Google Ads tag (AW-… from Ads → Data manager / Google tag). Fixes "Your website needs a Google tag".
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-737007274
NEXT_PUBLIC_BOOKING_URL=https://calendar.google.com/calendar/appointments/schedules/your-schedule-id
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-app-password
